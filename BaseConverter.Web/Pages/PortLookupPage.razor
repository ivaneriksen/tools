@page "/ports"

<PageTitle>Port Lookup</PageTitle>

<h1 class="fs-3">Port Lookup</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <label class="form-label" for="query">Search by number, name or description</label>
                <input id="query" class="form-control font-monospace" autocomplete="off"
                       @bind="query" @bind:event="oninput" placeholder="e.g. 443, ssh, email" />

                @if (RangeText != null)
                {
                    <div class="small text-secondary mt-2">@RangeText</div>
                }
            </div>
        </div>

        @if (Results.Count > 0)
        {
            @* Results found: show the table *@
            <div class="card mt-3">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Port</th>
                                <th>Name</th>
                                <th>Protocol</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (Port port in Results)
                            {
                                <tr>
                                    <td class="font-monospace">@port.Number</td>
                                    <td>@port.Name</td>
                                    <td>@port.Protocol</td>
                                    <td>@port.Description</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
        else if (IsValidPort)
        {
            @* A valid port, but no known service on it *@
            <div class="card mt-3">
                <div class="card-body p-4 text-secondary">No known services use this port.</div>
            </div>
        }
        else if (RangeText == null)
        {
            @* Text search with no hits *@
            <div class="card mt-3">
                <div class="card-body p-4 text-secondary">No known services match "@query".</div>
            </div>
        }
        @* Invalid number: no card, the range line already explains it *@
    </div>
</div>

@code {
    private string query = "";

    private List<Port> Results => PortLookup.Search(query);
    private string? RangeText => GetRangeText();
    private bool IsValidPort => long.TryParse(query, out long n) && n >= 0 && n <= 65535;

    private string? GetRangeText()
    {
        if (!long.TryParse(query, out long value)) return null;

        if (value < 0 || value > 65535) return $"{value} is not a valid port (0-65535)";

        string range = PortLookup.GetRange((int)value); // Safe since it's now confirmed between 0 and 65535

        string bounds = range switch
        {
            "Well-known" => "0-1023",
            "Registered" => "1024-49151",
            _ => "49152-65535"
        };

        return $"{value} is a {range.ToLower()} port ({bounds})";
    }
}