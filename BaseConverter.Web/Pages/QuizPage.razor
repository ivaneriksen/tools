@page "/quiz"
@inject IJSRuntime JS

<PageTitle>Base Conversion Quiz</PageTitle>

<h1 class="fs-3">Base Conversion Quiz</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card mb-3">
            <div class="card-body p-3">
                <!-- BASES -->
                <div class="small text-secondary mb-1">Bases</div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="base2"
                           checked="@selectedBases.Contains(2)"
                           disabled="@((selectedBases.Contains(2) && selectedBases.Count == 2) || secondsLeft > 0)"
                           @onchange="() => ToggleBase(2)" />
                    <label class="form-check-label" for="base2">Binary</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="base8"
                           checked="@selectedBases.Contains(8)"
                           disabled="@((selectedBases.Contains(8) && selectedBases.Count == 2) || secondsLeft > 0)"
                           @onchange="() => ToggleBase(8)" />
                    <label class="form-check-label" for="base8">Octal</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="base10"
                           checked="@selectedBases.Contains(10)"
                           disabled="@((selectedBases.Contains(10) && selectedBases.Count == 2) || secondsLeft > 0)"
                           @onchange="() => ToggleBase(10)" />
                    <label class="form-check-label" for="base10">Decimal</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" id="base16"
                           checked="@selectedBases.Contains(16)"
                           disabled="@((selectedBases.Contains(16) && selectedBases.Count == 2) || secondsLeft > 0)"
                           @onchange="() => ToggleBase(16)" />
                    <label class="form-check-label" for="base16">Hexadecimal</label>
                </div>
                <!-- DIFFICULTY-->
                <div class="small text-secondary mb-1 mt-3">Difficulty</div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="difficulty" id="easy"
                           checked="@(maxNumber == 15)"
                           disabled="@(secondsLeft > 0)"
                           @onchange="() => SetDifficulty(15)" />
                    <label class="form-check-label" for="easy">Easy <small class="text-secondary">(4 bits)</small></label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="difficulty" id="hard"
                           checked="@(maxNumber == 255)"
                           disabled="@(secondsLeft > 0)"
                           @onchange="() => SetDifficulty(255)" />
                    <label class="form-check-label" for="hard">Hard <small class="text-secondary">(8 bits)</small></label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="difficulty" id="insane"
                           checked="@(maxNumber == 65535)"
                           disabled="@(secondsLeft > 0)"
                           @onchange="() => SetDifficulty(65535)" />
                    <label class="form-check-label" for="insane">Insane <small class="text-secondary">(16 bits)</small></label>
                </div>
            </div>
        </div>
        <div class="card">
            <div class="card-body p-4">
                <form @onsubmit="CheckAnswer" @onsubmit:preventDefault>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="text-secondary">
                            Score @history.Count(a => a.IsCorrect)/@history.Count · High score @highScore
                        </div>

                        @if (secondsLeft > 0)
                        {
                            <span class="fs-5">@secondsLeft s</span>
                        }
                        else
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="StartChallenge">
                                ▶ 60s challenge
                            </button>
                        }
                    </div>

                    @if (challengeOver && history.Count > 0)
                    {
                        <div class="alert alert-secondary">
                            Correct: @history.Count(a => a.IsCorrect) |
                            Wrong: @history.Count(a => !a.IsCorrect) |
                            Accuracy: @(history.Count(a => a.IsCorrect) * 100 / history.Count)%
                        </div>
                    }

                    <p class="fs-4 text-center font-monospace my-4">@question</p>

                    <div class="input-group">
                        <input class="form-control font-monospace" @ref="answerInput" autocomplete="off"
                               @bind="userAnswer" @bind:event="oninput" placeholder="Your answer" />
                        <button type="submit" class="btn btn-outline-primary">Submit</button>
                    </div>

                    @if (secondsLeft == 0)
                    {
                        <div class="small text-secondary mt-2">Type "start" to begin a 60s challenge.</div>
                    }
                    else
                    {
                        <div class="small text-secondary mt-2">Type "stop" to end the challenge.</div>
                    }
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        @if (history.Count > 0)
        {
            <button type="button" class="btn btn-sm btn-outline-secondary mb-3"
                    @onclick="Clear" disabled="@(secondsLeft > 0)">
                Clear history
            </button>
        }
        @foreach (AnsweredQuestion aQ in history)
        {
            <p class="@(aQ.IsCorrect ? "text-success" : "text-danger")">
                <span class="font-monospace">@Format(aQ.Question.Number, aQ.Question.FromBase)</span> in base @aQ.Question.FromBase equals
                <span class="font-monospace">@Format(aQ.Question.Answer, aQ.Question.ToBase)</span> in base @aQ.Question.ToBase. Your answer:
                <span class="font-monospace">@aQ.UserAnswer</span>.
            </p>
        }
    </div>
</div>

@code {
    private ElementReference answerInput;
    private string question = "";
    private QuizQuestion quizQuestion;
    private string userAnswer = "";
    private List<int> selectedBases = [2, 16];
    private int maxNumber = 255;
    private record AnsweredQuestion(QuizQuestion Question, string UserAnswer, bool IsCorrect);
    private List<AnsweredQuestion> history = [];
    private int secondsLeft = 0;
    private bool challengeOver = false;
    private int highScore = 0;

    // For highscores
    private string HighScoreKey => $"quizBest{maxNumber}_{string.Join("-", selectedBases.Order())}";

    protected override async Task OnInitializedAsync()
    {
        MakeQuestion();
        await LoadHighScore();
    }

    private void MakeQuestion()
    {
        QuizQuestion previousQuestion = quizQuestion;
        do
        {
            quizQuestion = BaseQuiz.Generate(selectedBases.ToArray(), maxNumber, Random.Shared);
        }
        while (quizQuestion == previousQuestion);
        
        question = $"Convert {Format(quizQuestion.Number, quizQuestion.FromBase)} from base {quizQuestion.FromBase} to base {quizQuestion.ToBase}";
    }

    private async Task CheckAnswer()
    {
        // On 'start' begin challenge
        if (secondsLeft == 0 && userAnswer.ToLower().Trim() == "start")
        {
            userAnswer = "";
            await StartChallenge();
            return;
        }
        // On 'stop' interrup challenge
        if (secondsLeft > 0 && userAnswer.ToLower().Trim() == "stop")
        {
            userAnswer = "";
            secondsLeft = 0;
            return;
        }

        challengeOver = false;
        bool isAnswerCorrect = BaseQuiz.IsCorrect(quizQuestion, userAnswer);
        history.Insert(0, new AnsweredQuestion(quizQuestion, userAnswer, isAnswerCorrect));
        userAnswer = "";
        MakeQuestion();
    }

    private async Task ToggleBase(int baseValue)
    {
        if (selectedBases.Contains(baseValue))
        {
            selectedBases.Remove(baseValue);
        }
        else
        {
            selectedBases.Add(baseValue);
        }
        MakeQuestion();
        await LoadHighScore();
    }

    private async Task SetDifficulty(int max)
    {
        maxNumber = max;
        MakeQuestion();
        await LoadHighScore();
    }

    private async Task StartChallenge()
    {
        challengeOver = false;
        Clear();
        MakeQuestion();
        secondsLeft = 60;
        await RunTimer();
    }

    private void Clear()
    {
        history = [];
    }

    private async Task RunTimer()
    {
        using PeriodicTimer timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        while (secondsLeft > 0)
        {
            await timer.WaitForNextTickAsync();
            if (secondsLeft > 0) secondsLeft--;
            StateHasChanged();
        }
        challengeOver = true;
        await SaveHighScoreIfHigher();
    }

    private async Task LoadHighScore()
    {
        string? saved = await JS.InvokeAsync<string?>("localStorage.getItem", HighScoreKey);
        highScore = int.TryParse(saved, out int value) ? value : 0;
    }

    private async Task SaveHighScoreIfHigher()
    {
        int correct = history.Count(a => a.IsCorrect);
        if (correct > highScore)
        {
            highScore = correct;
            await JS.InvokeVoidAsync("localStorage.setItem", HighScoreKey, highScore.ToString());
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await answerInput.FocusAsync();
    }

    // Helper for showing binary numbers grouped in questions and history
    private static string Format(string number, int numberBase) => (numberBase == 2) ? Converter.GroupDigits(number) : number;
}