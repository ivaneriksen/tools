@page "/base-converter"
@inject IJSRuntime JS

<PageTitle>Base Converter</PageTitle>

<h1 class="fs-3">Base Converter</h1>

<div class="row">
    <div class="col-lg-6">
        <div class="card">
            <div class="card-body p-4">
                <form @onsubmit="DoConvert" @onsubmit:preventDefault>

                    <div class="row g-2 align-items-center mb-4">
                        <div class="col-2">
                            <label class="col-form-label">Number:</label>
                        </div>
                        <div class="col-5">
                            <input class="form-control" @bind="input" @bind:event="oninput" />
                        </div>
                        <div class="col-3">
                            <label class="col-form-label">From base:</label>
                        </div>
                        <div class="col-2">
                            <select class="form-select" @bind="fromBase">
                                @for (int b = 2; b <= 36; b++)
                                {
                                    <option value="@b">@b</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row g-2 mb-4">
                        <div class="col-5 offset-2">
                            <button type="submit" class="btn btn-outline-primary w-100">Convert</button>
                        </div>
                        <div class="col-2 offset-3">
                            <button type="button" class="btn btn-outline-primary w-100" @onclick="Swap" aria-label="Swap bases">
                                <i class="bi bi-arrow-down-up"></i>
                            </button>
                        </div>
                    </div>
                    

                    <div class="row g-2 align-items-center">
                        <div class="col-2">
                            <label class="col-form-label">Result:</label>
                        </div>
                        <div class="col-5">
                            <div class="input-group">
                                <input class="form-control" value="@result" readonly />
                                <button type="button" class="btn @(copied ? "btn-copied" : "btn-outline-primary")" @onclick="CopyResult" aria-label="Copy result">
                                    <i class="bi @(copied ? "bi-check-lg" : "bi-clipboard")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-3">
                            <label class="col-form-label">To base:</label>
                        </div>
                        <div class="col-2">
                            <select class="form-select" @bind="toBase">
                                @for (int b = 2; b <= 36; b++)
                                {
                                    <option value="@b">@b</option>
                                }
                            </select>
                        </div>
                    </div>

                    @if (errorMessage != null)
                    {
                        <div class="alert alert-danger mt-4 mb-0">@errorMessage</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>
@code {
    private string input = string.Empty;
    private int fromBase = 10;
    private int toBase = 2;
    private string result = string.Empty;
    private string? errorMessage = null;

    private bool copied;

    private void DoConvert()
    {
        try
        {
            result = Converter.Convert(input, fromBase, toBase);
            errorMessage = null;
        }
        catch (ArgumentException ex)
        {
            result = string.Empty;
            errorMessage = ex.Message;
        }
        catch (OverflowException)
        {
            result = string.Empty;
            errorMessage = "The number is too large to convert.";
        }
        catch (Exception ex)
        {
            result = string.Empty;
            errorMessage = "An unexpected error occurred: " + ex.Message;
        }
    }

    // Swap the from and to bases, and if there is a result, use it as the new input and convert again
    private void Swap()
    {
        (fromBase, toBase) = (toBase, fromBase);
        if (!string.IsNullOrWhiteSpace(result))
        {
            input = result;

            DoConvert();
        }
    }

    // Copy the result to the clipboard
    private async Task CopyResult()
    {
        if (!string.IsNullOrEmpty(result))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", result);
            copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            copied = false;
        }
    }
}
