@page "/ipv6"
@inject IJSRuntime JS

<PageTitle>IPv6 Formatter</PageTitle>

<h1 class="fs-3">IPv6 Formatter</h1>

<div class="row">
    <div class="col-lg-6">

        <div class="card mb-4">
            <div class="card-body p-4">
                <label class="form-label">IPv6 address</label>
                <input class="form-control font-monospace"
                       @bind="input" @bind:event="oninput" @bind:after="Update" />
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @if (result != null)
        {
            <div class="card">
                <div class="card-body p-4">
                    <label class="form-label">Short form</label>
                    <div class="input-group mb-3">
                        <input class="form-control font-monospace" value="@result.Value.ShortAddress" readonly />
                        <button type="button" class="btn @(copied == "short" ? "btn-copied" : "btn-outline-primary")"
                                @onclick='() => Copy(result.Value.ShortAddress, "short")'>
                            <i class="bi @(copied == "short" ? "bi-check-lg" : "bi-clipboard")"></i>
                        </button>
                    </div>

                    <label class="form-label">Trimmed form</label>
                    <div class="input-group mb-3">
                        <input class="form-control font-monospace" value="@result.Value.TrimmedAddress" readonly />
                        <button type="button" class="btn @(copied == "trimmed" ? "btn-copied" : "btn-outline-primary")"
                                @onclick='() => Copy(result.Value.TrimmedAddress, "trimmed")'>
                            <i class="bi @(copied == "trimmed" ? "bi-check-lg" : "bi-clipboard")"></i>
                        </button>
                    </div>

                    <label class="form-label">Full form</label>
                    <div class="input-group">
                        <input class="form-control font-monospace" value="@result.Value.FullAddress" readonly />
                        <button type="button" class="btn @(copied == "full" ? "btn-copied" : "btn-outline-primary")"
                                @onclick='() => Copy(result.Value.FullAddress, "full")'>
                            <i class="bi @(copied == "full" ? "bi-check-lg" : "bi-clipboard")"></i>
                        </button>
                    </div>
                </div>
            </div>
        }

    </div>
</div>

@code {
    private string input = "2001:db8::1";
    private Ipv6Result? result = null;
    private string? errorMessage = null;

    private string? copied;

    protected override void OnInitialized()
    {
        Update();
    }

    private void Update()
    {
        if (string.IsNullOrWhiteSpace(input))
        {
            result = null;
            errorMessage = null;
            return;
        }

        try
        {
            result = Ipv6Formatter.Format(input);
            errorMessage = null;
        }
        catch (ArgumentException ex)
        {
            result = null;
            errorMessage = ex.Message;
        }
    }

    private async Task Copy(string text, string which)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        copied = which;
        StateHasChanged();
        await Task.Delay(1500);
        copied = null;
    }
}